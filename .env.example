# ============================================================
# Department Ease - Backend Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# ----------------------------------------------------------
# DATABASE (Required)
# For LOCAL: mongodb://localhost:27017
# For PRODUCTION (MongoDB Atlas): mongodb+srv://user:password@cluster.mongodb.net/
# ----------------------------------------------------------
MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxxx.mongodb.net/?appName=Cluster0
DATABASE_NAME=department_ease

# ----------------------------------------------------------
# JWT Authentication (Required)
# Generate a strong SECRET_KEY (e.g. run: openssl rand -hex 32)
# ----------------------------------------------------------
SECRET_KEY=your-very-strong-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# Google Gemini AI (Optional - only needed for AI Chat feature)
# Get your key at: https://aistudio.google.com/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ----------------------------------------------------------
# SMTP Email Configuration (Optional - needed for email notifications)
# For Gmail: enable 2FA and create an App Password
# ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Department Administration System

# ----------------------------------------------------------
# Redis (Optional - only needed for Celery background tasks)
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------
# Application Settings (Required)
# CORS_ORIGINS: Comma-separated list of allowed frontend URLs
# For Vercel: add your Vercel deployment URL here
# ----------------------------------------------------------
APP_NAME=Department Ease
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-app.vercel.app
